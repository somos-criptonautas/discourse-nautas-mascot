diff --git a/common/common.scss b/common/common.scss
index 68009d8..c3ba8e3 100644
--- a/common/common.scss
+++ b/common/common.scss
@@ -47,8 +47,9 @@ $cycle: 6s;
     opacity: 0;
   }
 
-  // idle: breathe and blink now and then
+  // idle: breathe and blink now and then; shown at rest so it stays visible without animations
   &__frame--idle {
+    opacity: 1;
     animation: nautas-mascot-idle $cycle steps(1, end) infinite;
   }
 
