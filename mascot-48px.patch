 docs/frames.py                                | 253 ++++++++++++++++++
 .../discourse/components/nautas-mascot.gjs    |  36 ++-
 javascripts/discourse/lib/mascot-frames.js    | 229 ++++++++++++++--
 locales/en.yml                                |   2 +-
 locales/es.yml                                |   2 +-
 settings.yml                                  |   2 +-
 spec/system/screenshots_spec.rb               |  11 +-
 test/acceptance/nautas-mascot-test.js         |   3 +
